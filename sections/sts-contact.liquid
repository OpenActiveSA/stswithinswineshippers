{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .sts-contact {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .sts-contact__inner {
    width: min(110rem, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4.8rem;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .sts-contact__eyebrow {
    margin: 0 0 1.2rem;
    color: var(--sts-gold);
    font-size: 1.2rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sts-contact__heading {
    margin: 0 0 3.2rem;
    font-family: var(--sts-font-display, 'DM Sans', system-ui, sans-serif);
    font-size: clamp(2.8rem, 4vw, 4.2rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--sts-ink);
  }

  #shopify-section-{{ section.id }} .sts-contact__item {
    padding: 0 0 2.2rem;
    margin: 0 0 2.2rem;
    border-bottom: 1px solid var(--sts-gold);
  }

  #shopify-section-{{ section.id }} .sts-contact__item:last-child {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: 0;
  }

  #shopify-section-{{ section.id }} .sts-contact__item h2 {
    margin: 0 0 0.7rem;
    font-size: 1.2rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sts-gold);
  }

  #shopify-section-{{ section.id }} .sts-contact__item p,
  #shopify-section-{{ section.id }} .sts-contact__item a {
    margin: 0;
    color: var(--sts-ink);
    font-size: 1.55rem;
    line-height: 1.6;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .sts-contact__item a:hover {
    color: var(--sts-gold);
  }

  #shopify-section-{{ section.id }} .sts-contact__form .title {
    margin: 0 0 2.4rem;
    font-family: var(--sts-font-display, 'DM Sans', system-ui, sans-serif);
    font-size: clamp(2.4rem, 3vw, 3.2rem);
    font-weight: 400;
    color: var(--sts-ink);
  }

  #shopify-section-{{ section.id }} .sts-contact__form .contact {
    max-width: none;
    padding: 0;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sts-contact__inner {
      grid-template-columns: minmax(24rem, 0.8fr) minmax(0, 1.4fr);
      gap: 7rem;
    }
  }
{%- endstyle -%}

<section class="sts-contact" {{ section.shopify_attributes }}>
  <div class="sts-contact__inner">
    <aside class="sts-contact__aside">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sts-contact__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="sts-contact__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.hours != blank -%}
        <div class="sts-contact__item">
          <h2>Hours</h2>
          <p>{{ section.settings.hours }}</p>
        </div>
      {%- endif -%}
      {%- if section.settings.address != blank -%}
        <div class="sts-contact__item">
          <h2>Find us</h2>
          <p>{{ section.settings.address }}</p>
        </div>
      {%- endif -%}
      {%- if section.settings.phone != blank or section.settings.email != blank -%}
        <div class="sts-contact__item">
          <h2>Enquire</h2>
          {%- if section.settings.phone != blank -%}
            <p><a href="tel:{{ section.settings.phone | replace: ' ', '' }}">{{ section.settings.phone }}</a></p>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <p><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.manager != blank -%}
        <div class="sts-contact__item">
          <h2>General manager</h2>
          <p>{{ section.settings.manager }}</p>
        </div>
      {%- endif -%}
    </aside>

    <div class="sts-contact__form">
      <div class="contact">
        {%- if section.settings.form_heading != blank -%}
          <h2 class="title title-wrapper--no-top-margin">{{ section.settings.form_heading }}</h2>
        {%- endif -%}
        {%- form 'contact', id: 'ContactForm', class: 'isolate' -%}
          {%- if form.posted_successfully? -%}
            <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
              {{- 'icon-success.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.post_success' | t }}
            </h2>
          {%- elsif form.errors -%}
            <div class="form__message">
              <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                {{- 'icon-error.svg' | inline_asset_content -}}
                {{ 'templates.contact.form.error_heading' | t }}
              </h2>
            </div>
          {%- endif -%}
          <div class="contact__fields">
            <div class="field">
              <input class="field__input" autocomplete="name" type="text" id="ContactForm-name" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="{{ 'templates.contact.form.name' | t }}">
              <label class="field__label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
            </div>
            <div class="field">
              <input autocomplete="email" type="email" id="ContactForm-email" class="field__input" name="contact[email]" spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" aria-required="true" required placeholder="{{ 'templates.contact.form.email' | t }}">
              <label class="field__label" for="ContactForm-email">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
            </div>
          </div>
          <div class="field">
            <input type="tel" id="ContactForm-phone" class="field__input" autocomplete="tel" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="{{ 'templates.contact.form.phone' | t }}">
            <label class="field__label" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
          </div>
          <div class="field">
            <textarea rows="8" id="ContactForm-body" class="text-area field__input" name="contact[body]" placeholder="{{ 'templates.contact.form.comment' | t }}">{{- form.body -}}</textarea>
            <label class="form__label field__label" for="ContactForm-body">{{ 'templates.contact.form.comment' | t }}</label>
          </div>
          <div class="contact__button">
            <button type="submit" class="button">{{ 'templates.contact.form.send' | t }}</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "STS Contact",
  "tag": "section",
  "class": "section-sts-contact",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send a message" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Monday to Friday, 12pm–10pm" },
    { "type": "textarea", "id": "address", "label": "Address", "default": "11-12 St Swithin's Lane, London EC4N 8AL" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+44 20 7621 9972" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@stswithinswineshippers.com" },
    { "type": "text", "id": "manager", "label": "General manager", "default": "Frederic Ahuir" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f5f1ea" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 }
  ],
  "presets": [{ "name": "STS Contact" }]
}
{% endschema %}
