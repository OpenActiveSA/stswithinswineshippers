{%- style -%}
  #shopify-section-{{ section.id }} .sts-hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #1c1c1a;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .sts-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .sts-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .sts-hero__overlay {
    position: absolute !important;
    inset: 0 !important;
    z-index: 1 !important;
    pointer-events: none !important;
    display: block !important;
    opacity: 1 !important;
    background:
      linear-gradient(
        180deg,
        rgba(28, 28, 26, 0.95) 0%,
        rgba(28, 28, 26, 0.65) 18%,
        rgba(28, 28, 26, 0) 40%
      ),
      rgba(28, 28, 26, 0.5) !important;
  }

  #shopify-section-{{ section.id }} .sts-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 96rem;
    margin: 0 auto;
    padding: 14rem 2rem 7rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sts-hero__heading {
    margin: 0 0 3rem;
    font-family: 'DM Sans', system-ui, sans-serif !important;
    font-weight: 300 !important;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .sts-hero__line {
    display: block;
    font-size: clamp(3.6rem, 7.5vw, 7.2rem);
    font-weight: 300 !important;
  }

  #shopify-section-{{ section.id }} .sts-hero__line--light {
    color: #ffffff !important;
  }

  #shopify-section-{{ section.id }} .sts-hero__line--gold {
    color: #d4c391 !important;
  }

  #shopify-section-{{ section.id }} .sts-btn--hero-primary {
    background: #ffffff;
    color: #4a1c1c;
    border: 1px solid #ffffff;
    border-radius: 999px;
    min-width: 18rem;
    min-height: 5.2rem;
    padding: 0 2.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1.45rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sts-btn--hero-secondary {
    background: rgba(28, 28, 26, 0.45);
    color: #d4c391 !important;
    border: 2px solid #d4c391;
    border-radius: 999px;
    min-width: 18rem;
    min-height: 5.2rem;
    padding: 0 2.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1.45rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sts-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    justify-content: center;
  }
{%- endstyle -%}

<section class="sts-hero">
  <div class="sts-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          widths: '800, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          alt: section.settings.heading_line_1
      }}
    {%- else -%}
      <img
        src="{{ 'mainbanner-background.png' | asset_url }}"
        alt="{{ section.settings.heading_line_1 | escape }}"
        width="2400"
        height="1350"
        loading="eager"
        fetchpriority="high"
        class="sts-hero__img"
      >
    {%- endif -%}
  </div>

  <div class="sts-hero__overlay" aria-hidden="true"></div>

  <div class="sts-hero__content">
    <h1 class="sts-hero__heading">
      <span class="sts-hero__line sts-hero__line--light">
        {{ section.settings.heading_line_1 | default: 'Destination for' }}
      </span>
      <span class="sts-hero__line">
        <span class="sts-hero__line--light">{{ section.settings.heading_line_2 | default: 'Wine' }}</span><span class="sts-hero__line--gold">&nbsp;{{ section.settings.heading_line_3 | default: 'Enthusiasts' }}</span>
      </span>
    </h1>

    <div class="sts-hero__actions">
      {%- if section.settings.button_label_1 != blank -%}
        <a
          href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}"
          class="sts-btn sts-btn--hero-primary"
        >
          {{ section.settings.button_label_1 }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a
          href="{{ section.settings.button_link_2 | default: '#' }}"
          class="sts-btn sts-btn--hero-secondary"
        >
          {{ section.settings.button_label_2 }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "STS Hero",
  "tag": "section",
  "class": "section-sts-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Destination for"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (white)",
      "default": "Wine"
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Heading accent (gold)",
      "default": "Enthusiasts"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "VIEW OUR WINES"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "BOOK A VISIT"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "STS Hero"
    }
  ]
}
{% endschema %}
