{%- style -%}
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }}.shopify-section,
  #shopify-section-{{ section.id }}.section-sts-shop-intro {
    margin: 0 !important;
    padding: 0 !important;
    overflow: visible !important;
    position: relative !important;
    z-index: 40 !important;
  }

  #shopify-section-{{ section.id }} .sts-shop-intro {
    background: #1c1c1a !important;
    color: #ffffff;
    text-align: center;
    padding-top: 45px !important;
    padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px !important;
    padding-left: 2rem;
    padding-right: 2rem;
    overflow: visible !important;
    position: relative;
    z-index: 40;
  }

  #shopify-section-{{ section.id }} .sts-shop-intro__title {
    font-family: var(--sts-font-display, 'DM Sans', system-ui, sans-serif) !important;
    font-size: clamp(3.2rem, 5.5vw, 5.2rem) !important;
    font-weight: 400 !important;
    letter-spacing: 0.01em;
    line-height: 1.15;
    margin: 0 auto 1.8rem !important;
    max-width: 71rem !important;
    width: 100%;
    color: #ffffff !important;
  }

  #shopify-section-{{ section.id }} .sts-shop-intro__text,
  #shopify-section-{{ section.id }} .sts-shop-intro__text p {
    max-width: 58rem;
    margin: 0 auto 3rem;
    color: rgba(255, 255, 255, 0.92) !important;
    font-size: 1.5rem;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .sts-shop-intro__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    justify-content: center;
    overflow: visible !important;
    position: relative;
    z-index: 50;
  }

  #shopify-section-{{ section.id }} .sts-shop-filter {
    position: relative;
    min-width: 14rem;
    z-index: 51;
  }

  #shopify-section-{{ section.id }} .sts-shop-filter[open] {
    z-index: 60;
  }

  #shopify-section-{{ section.id }} .sts-shop-filter__button {
    cursor: pointer;
    list-style: none;
    min-width: 14rem;
    padding: 1rem 2rem;
    border: 2px solid #d4c391 !important;
    border-radius: 999px;
    color: #d4c391;
    font-family: inherit;
    font-size: 1.15rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    box-sizing: border-box;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .sts-shop-filter__button::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .sts-shop-filter__button::marker {
    content: '';
    display: none;
  }

  #shopify-section-{{ section.id }} .sts-shop-filter__button span {
    color: #d4c391;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .sts-shop-filter__menu {
    display: none;
    position: absolute;
    left: 50%;
    top: calc(100% + 0.8rem);
    transform: translateX(-50%);
    z-index: 70;
    min-width: max(100%, 18rem);
    max-height: 28rem;
    overflow: auto;
    margin: 0;
    padding: 0.8rem 0;
    list-style: none;
    text-align: left;
    background: #1c1c1a;
    border: 1px solid #d4c391;
    border-radius: 1.2rem;
    box-shadow: 0 1.2rem 3rem rgba(0, 0, 0, 0.45);
  }

  #shopify-section-{{ section.id }} .sts-shop-filter[open] .sts-shop-filter__menu {
    display: block;
  }

  #shopify-section-{{ section.id }} .sts-shop-filter__menu a {
    display: block;
    padding: 0.85rem 1.6rem;
    color: #ffffff !important;
    text-decoration: none;
    font-size: 1.3rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .sts-shop-filter__menu a:hover,
  #shopify-section-{{ section.id }} .sts-shop-filter__menu a.is-active {
    color: #d4c391 !important;
  }

  #shopify-section-{{ section.id }} .sts-shop-filter__empty {
    padding: 0.85rem 1.6rem;
    color: rgba(255, 255, 255, 0.65);
    font-size: 1.2rem;
  }
{%- endstyle -%}

{%- liquid
  assign type_filter = blank
  assign brand_filter = blank
  assign vintage_filter = blank

  for filter in collection.filters
    assign label = filter.label | downcase
    if label == 'type' or label == 'product type'
      assign type_filter = filter
    elsif label == 'brand' or label == 'vendor'
      assign brand_filter = filter
    elsif label == 'vintage' or label == 'year'
      assign vintage_filter = filter
    endif
  endfor

  assign type_options = ''
  assign known_types = 'Red Wine,White Wine,Rosé,Rose,Sparkling,Sweet,Sweet Wine,Fortified,Armagnac,Cognac,Eau-de-Vie,Orange Wine,Orange' | split: ','

  for type_name in known_types
    if collection.all_tags contains type_name
      if type_options == blank
        assign type_options = type_name
      else
        assign type_options = type_options | append: '|' | append: type_name
      endif
    endif
  endfor

  for product_type in collection.all_types
    unless type_options contains product_type
      if type_options == blank
        assign type_options = product_type
      else
        assign type_options = type_options | append: '|' | append: product_type
      endif
    endunless
  endfor

  if type_filter != blank
    for value in type_filter.values
      unless type_options contains value.label
        if type_options == blank
          assign type_options = value.label
        else
          assign type_options = type_options | append: '|' | append: value.label
        endif
      endunless
    endfor
  endif

  assign type_option_list = type_options | split: '|'
-%}

<div class="sts-shop-intro" data-sts-shop-intro>
  <h1 class="sts-shop-intro__title">
    {%- if section.settings.heading != blank -%}
      {{ section.settings.heading }}
    {%- else -%}
      {{ collection.title | escape }}
    {%- endif -%}
  </h1>

  {%- if section.settings.text != blank -%}
    <div class="sts-shop-intro__text rte">{{ section.settings.text }}</div>
  {%- elsif collection.description != blank -%}
    <div class="sts-shop-intro__text rte">{{ collection.description }}</div>
  {%- endif -%}

  {%- if section.settings.show_filter_labels -%}
    <div class="sts-shop-intro__filters" data-sts-filters>
      <details class="sts-shop-filter">
        <summary class="sts-shop-filter__button">
          TYPE
          <span aria-hidden="true">▾</span>
        </summary>
        <ul class="sts-shop-filter__menu">
          <li>
            <a href="{{ collection.url }}">All types</a>
          </li>
          {%- if type_option_list.size > 0 and type_options != blank -%}
            {%- for type_name in type_option_list -%}
              {%- if type_name != blank -%}
                <li>
                  {%- assign type_encoded = type_name | url_encode -%}
                  {%- assign type_link = collection.url | append: '?filter.p.product_type=' | append: type_encoded -%}
                  {%- if type_filter != blank -%}
                    {%- for value in type_filter.values -%}
                      {%- if value.label == type_name -%}
                        {%- assign type_link = value.url_to_add -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                  {%- if collection.all_tags contains type_name -%}
                    {%- assign type_handle = type_name | handleize -%}
                    {%- assign type_link = collection.url | append: '/' | append: type_handle -%}
                  {%- endif -%}
                  <a
                    href="{{ type_link }}"
                    {% if current_tags contains type_name %}class="is-active"{% endif %}
                  >
                    {{ type_name | escape }}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- elsif type_filter != blank -%}
            {%- for value in type_filter.values -%}
              <li>
                <a href="{{ value.url_to_add }}" {% if value.active %}class="is-active"{% endif %}>
                  {{ value.label | escape }}
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="sts-shop-filter__empty">No types found yet</li>
          {%- endif -%}
        </ul>
      </details>

      <details class="sts-shop-filter">
        <summary class="sts-shop-filter__button">
          BRAND
          <span aria-hidden="true">▾</span>
        </summary>
        <ul class="sts-shop-filter__menu">
          <li>
            <a href="{{ collection.url }}">All brands</a>
          </li>
          {%- if brand_filter != blank -%}
            {%- for value in brand_filter.values -%}
              <li>
                <a href="{{ value.url_to_add }}" {% if value.active %}class="is-active"{% endif %}>
                  {{ value.label | escape }}
                </a>
              </li>
            {%- endfor -%}
          {%- elsif collection.all_vendors.size > 0 -%}
            {%- for vendor in collection.all_vendors -%}
              <li>
                <a href="{{ collection.url }}?filter.p.vendor={{ vendor | url_encode }}">
                  {{ vendor | escape }}
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="sts-shop-filter__empty">No brands found yet</li>
          {%- endif -%}
        </ul>
      </details>

      <details class="sts-shop-filter">
        <summary class="sts-shop-filter__button">
          VINTAGE
          <span aria-hidden="true">▾</span>
        </summary>
        <ul class="sts-shop-filter__menu">
          <li>
            <a href="{{ collection.url }}">All vintages</a>
          </li>
          {%- if vintage_filter != blank -%}
            {%- for value in vintage_filter.values -%}
              <li>
                <a href="{{ value.url_to_add }}" {% if value.active %}class="is-active"{% endif %}>
                  {{ value.label | escape }}
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- assign vintage_found = false -%}
            {%- for tag in collection.all_tags -%}
              {%- assign year_num = tag | plus: 0 -%}
              {%- if tag.size == 4 and year_num >= 1990 and year_num <= 2035 -%}
                {%- assign vintage_found = true -%}
                <li>
                  <a
                    href="{{ collection.url }}/{{ tag | handleize }}"
                    {% if current_tags contains tag %}class="is-active"{% endif %}
                  >
                    {{ tag | escape }}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
            {%- unless vintage_found -%}
              <li class="sts-shop-filter__empty">No vintages tagged yet</li>
            {%- endunless -%}
          {%- endif -%}
        </ul>
      </details>
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var script = document.currentScript;
    var root = script && script.previousElementSibling;
    if (!root || !root.hasAttribute('data-sts-shop-intro')) {
      root = document.querySelector('[data-sts-shop-intro]');
    }
    if (!root) return;

    var filtersRoot = root.querySelector('[data-sts-filters]');
    if (!filtersRoot) return;

    filtersRoot.addEventListener('toggle', function (event) {
      var target = event.target;
      if (!target || target.tagName !== 'DETAILS' || !target.open) return;
      filtersRoot.querySelectorAll('details.sts-shop-filter[open]').forEach(function (el) {
        if (el !== target) el.removeAttribute('open');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "STS Collection intro",
  "tag": "section",
  "class": "section-sts-shop-intro",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop wines with personality",
      "info": "Leave blank to use the collection title"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>From bold reds to crisp whites, every bottle is chosen for its unique story and quality. Explore our collection and uncover something unexpected.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_filter_labels",
      "label": "Show filter dropdowns",
      "default": true,
      "info": "Uses native browser dropdowns. Enable Product type + Brand in Search & Discovery for full filter links."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 45
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "STS Collection intro"
    }
  ]
}
{% endschema %}
