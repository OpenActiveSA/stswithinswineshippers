{% comment %}
  Renders pagination as STS pill dots (matches hero / collection sliders).

  Usage:
  {% paginate results by 2 %}
    {% render 'pagination', paginate: paginate, anchor: '#yourID' %}
  {% endpaginate %}

  Accepts:
  - paginate: {Object}
  - anchor: {String} (optional)
{% endcomment %}

{%- if paginate.pages > 1 -%}
  <div class="pagination-wrapper sts-pagination" data-page="{{ paginate.current_page }}">
    <nav
      class="pagination sts-slider-dots"
      role="navigation"
      aria-label="{{ 'general.pagination.label' | t }}"
    >
      <div class="sts-slider-dots__list sts-pagination__dots">
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a
              href="{{ part.url }}{{ anchor }}"
              class="sts-slider-dots__dot"
              aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
            >
              <span class="visually-hidden">{{ part.title }}</span>
            </a>
          {%- elsif part.title == paginate.current_page -%}
            <a
              role="link"
              aria-disabled="true"
              class="sts-slider-dots__dot is-active"
              aria-current="page"
              aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
            >
              <span class="visually-hidden">{{ part.title }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </nav>
  </div>
{%- endif -%}
