{%- style -%}
  #shopify-section-{{ section.id }}.section-sts-shop-intro,
  #shopify-section-{{ section.id }} {
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .sts-shop-intro {
    background: #1c1c1a !important;
    color: #ffffff;
    text-align: center;
    padding-top: 45px !important;
    padding-bottom: {{ section.settings.padding_bottom | default: 56 }}px !important;
    padding-left: 2rem;
    padding-right: 2rem;
  }

  #shopify-section-{{ section.id }} .sts-shop-intro__title {
    font-family: var(--sts-font-display, 'DM Sans', system-ui, sans-serif) !important;
    font-size: clamp(3.2rem, 5.5vw, 5.2rem) !important;
    font-weight: 400 !important;
    letter-spacing: 0.01em;
    line-height: 1.15;
    margin: 0 auto 1.8rem !important;
    max-width: 71rem !important;
    width: 100%;
    color: #ffffff !important;
  }

  #shopify-section-{{ section.id }} .sts-shop-intro__text,
  #shopify-section-{{ section.id }} .sts-shop-intro__text p {
    max-width: 58rem;
    margin: 0 auto 3rem;
    color: rgba(255, 255, 255, 0.92) !important;
    font-size: 1.5rem;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .sts-shop-intro__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .sts-shop-intro__filter {
    min-width: 14rem;
    padding: 1rem 2rem;
    border: 2px solid #d4c391;
    border-radius: 999px;
    color: #d4c391;
    font-size: 1.15rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  #shopify-section-{{ section.id }} .sts-shop-intro__filter span {
    color: #d4c391;
  }
{%- endstyle -%}

<div class="sts-shop-intro">
  <h1 class="sts-shop-intro__title">
    {%- if section.settings.heading != blank -%}
      {{ section.settings.heading }}
    {%- else -%}
      {{ collection.title | escape }}
    {%- endif -%}
  </h1>

  {%- if section.settings.text != blank -%}
    <div class="sts-shop-intro__text rte">{{ section.settings.text }}</div>
  {%- elsif collection.description != blank -%}
    <div class="sts-shop-intro__text rte">{{ collection.description }}</div>
  {%- endif -%}

  {%- if section.settings.show_filter_labels -%}
    <div class="sts-shop-intro__filters" aria-hidden="true">
      <span class="sts-shop-intro__filter">TYPE <span>▾</span></span>
      <span class="sts-shop-intro__filter">BRAND <span>▾</span></span>
      <span class="sts-shop-intro__filter">VINTAGE <span>▾</span></span>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "STS Collection intro",
  "tag": "section",
  "class": "section-sts-shop-intro",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop wines with personality",
      "info": "Leave blank to use the collection title"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>From bold reds to crisp whites, every bottle is chosen for its unique story and quality. Explore our collection and uncover something unexpected.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_filter_labels",
      "label": "Show decorative filter labels",
      "default": true,
      "info": "Real filters appear below once enabled in Search & Discovery"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 1,
      "unit": "px",
      "label": "Padding top",
      "default": 45
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "STS Collection intro"
    }
  ]
}
{% endschema %}
