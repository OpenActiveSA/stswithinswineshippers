{%- comment -%}
  Outputs "skip" when pretty_route is set and the current URL is not that handle.
{%- endcomment -%}
{%- liquid
  if pretty_route != blank
    assign pretty_last = ''
    assign pretty_parts = request.path | split: '?' | first | downcase | split: '/'
    for pretty_part in pretty_parts
      if pretty_part != blank
        assign pretty_last = pretty_part
      endif
    endfor
    if pretty_last != pretty_route
      echo 'skip'
    endif
  endif
-%}
