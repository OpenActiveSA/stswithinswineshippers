{%- liquid
  assign pretty_path = request.path | split: '?' | first | downcase
  if pretty_path == '/visit' or pretty_path == '/visit/'
    assign pretty_redirect = '/pages/visit'
  elsif pretty_path == '/contact' or pretty_path == '/contact/'
    assign pretty_redirect = '/pages/contact'
  elsif pretty_path == '/about' or pretty_path == '/about/'
    assign pretty_redirect = '/pages/about'
  endif
-%}
{%- if pretty_redirect != blank -%}
  <meta http-equiv="refresh" content="0;url={{ pretty_redirect }}">
  <script>
    location.replace({{ pretty_redirect | json }});
  </script>
{%- endif -%}

<style type="text/css">
  .template-404 .title + * {
    margin-top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .template-404 .title + * {
      margin-top: 2rem;
    }
  }
</style>

<div class="template-404 page-width page-margin center">
  <p>
    {{ 'templates.404.subtext' | t }}
  </p>
  <h1 class="title">
    {{ 'templates.404.title' | t }}
  </h1>
  {%- if settings.hide_shopping -%}
    <a href="{{ routes.root_url }}" class="button">Home</a>
  {%- else -%}
    <a href="{{ routes.all_products_collection_url }}" class="button">
      {{ 'general.continue_shopping' | t }}
    </a>
  {%- endif -%}
</div>
