{%- liquid
  assign instagram_url = settings.social_instagram_link | default: 'https://www.instagram.com/stswithinswine'
  assign facebook_url = settings.social_facebook_link | default: 'https://www.facebook.com/stswithinswine'
  assign twitter_url = settings.social_twitter_link | default: 'https://www.twitter.com/stswithinswine'
  assign widget_url = 'https://booking.resdiary.com/widget/Standard/StSwithinsWineShippers/53853'
-%}
{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .sts-pretty-page {
    display: none;
  }
  html.sts-pretty--about #shopify-section-{{ section.id }} .sts-pretty-page--about,
  html.sts-pretty--visit #shopify-section-{{ section.id }} .sts-pretty-page--visit,
  html.sts-pretty--contact #shopify-section-{{ section.id }} .sts-pretty-page--contact {
    display: block;
  }

  #shopify-section-{{ section.id }} .sts-prose {
    background: #f5f1ea;
    padding: 5.6rem 2rem 2.4rem;
  }
  #shopify-section-{{ section.id }} .sts-prose__inner {
    width: min(76rem, 100%);
    margin: 0 auto;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .sts-prose__eyebrow {
    margin: 0 0 1.2rem;
    color: #c4a574;
    font-size: 1.2rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .sts-prose__heading {
    margin: 0 0 1.8rem;
    font-family: var(--sts-font-display, 'DM Sans', system-ui, sans-serif);
    font-size: clamp(2.8rem, 4.4vw, 4.6rem);
    font-weight: 400;
    line-height: 1.15;
    color: #1c1c1a;
  }
  #shopify-section-{{ section.id }} .sts-prose__text,
  #shopify-section-{{ section.id }} .sts-prose__text p {
    margin: 0 0 1.4rem;
    color: #6b6560;
    font-size: 1.55rem;
    line-height: 1.7;
  }
  #shopify-section-{{ section.id }} .sts-prose__actions {
    margin-top: 2.4rem;
  }

  #shopify-section-{{ section.id }} .sts-features {
    background: #ebe6dc;
    padding: 3.2rem 2rem 5.6rem;
  }
  #shopify-section-{{ section.id }} .sts-features__inner {
    width: min(118rem, 100%);
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .sts-features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }
  #shopify-section-{{ section.id }} .sts-features__card {
    background: #ffffff;
    padding: 2.8rem 2.4rem;
    border-top: 3px solid #d4c391;
  }
  #shopify-section-{{ section.id }} .sts-features__card h2 {
    margin: 0 0 1.2rem;
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #4a1c1c;
  }
  #shopify-section-{{ section.id }} .sts-features__card p {
    margin: 0;
    color: #6b6560;
    font-size: 1.45rem;
    line-height: 1.65;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sts-features__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  #shopify-section-{{ section.id }} .sts-split {
    background: #f5f1ea;
    padding: 4.8rem 2rem 2.4rem;
  }
  #shopify-section-{{ section.id }} .sts-split__inner {
    width: min(118rem, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .sts-split__media img {
    width: 100%;
    height: 100%;
    min-height: 32rem;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .sts-split__copy h2 {
    margin: 0 0 1.4rem;
    font-family: var(--sts-font-display, 'DM Sans', system-ui, sans-serif);
    font-size: clamp(2.4rem, 3.5vw, 3.6rem);
    font-weight: 400;
    color: #1c1c1a;
  }
  #shopify-section-{{ section.id }} .sts-split__copy p {
    margin: 0;
    color: #6b6560;
    font-size: 1.5rem;
    line-height: 1.7;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sts-split__inner {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
    #shopify-section-{{ section.id }} .sts-split--image-right .sts-split__media {
      order: 2;
    }
  }

  #shopify-section-{{ section.id }} .sts-gallery__intro {
    text-align: center;
    max-width: 62rem;
    margin: 0 auto 2.4rem;
    padding: 0 1.6rem;
  }
  #shopify-section-{{ section.id }} .sts-gallery__heading {
    margin: 0 0 1.2rem;
    font-family: var(--sts-font-display, 'DM Sans', system-ui, sans-serif);
    font-size: clamp(2.8rem, 4.2vw, 4.4rem);
    font-weight: 400;
    color: #1c1c1a;
  }
  #shopify-section-{{ section.id }} .sts-gallery__text,
  #shopify-section-{{ section.id }} .sts-gallery__text p {
    margin: 0;
    color: #6b6560;
    font-size: 1.5rem;
    line-height: 1.65;
  }
  #shopify-section-{{ section.id }} .sts-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-flow: dense;
    gap: 4px;
    padding: 0 4px;
  }
  #shopify-section-{{ section.id }} .sts-gallery__item {
    position: relative;
    display: block;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 2 / 3;
    background: #ece8e0;
  }
  #shopify-section-{{ section.id }} .sts-gallery__item--wide {
    grid-column: span 2;
    aspect-ratio: 3 / 2;
  }
  #shopify-section-{{ section.id }} .sts-gallery__item img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sts-gallery__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .sts-resdiary {
    background: #f5f1ea;
    padding: 4.8rem 2rem 5.6rem;
  }
  #shopify-section-{{ section.id }} .sts-resdiary__inner {
    width: min(72rem, 100%);
    margin: 0 auto;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .sts-resdiary__eyebrow {
    margin: 0 0 1.2rem;
    color: #c4a574;
    font-size: 1.2rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .sts-resdiary__heading {
    margin: 0 0 1.2rem;
    font-family: var(--sts-font-display, 'DM Sans', system-ui, sans-serif);
    font-size: clamp(2.8rem, 4.2vw, 4.4rem);
    font-weight: 400;
    color: #1c1c1a;
  }
  #shopify-section-{{ section.id }} .sts-resdiary__text p {
    margin: 0 0 2.4rem;
    color: #6b6560;
    font-size: 1.55rem;
    line-height: 1.7;
  }
  #shopify-section-{{ section.id }} .sts-resdiary__frame {
    display: block;
    width: 100%;
    max-width: 60rem;
    height: 72rem;
    margin: 0 auto;
    border: 0;
    background: #ffffff;
  }
  #shopify-section-{{ section.id }} .sts-resdiary__fallback {
    margin: 1.6rem 0 0;
  }

  #shopify-section-{{ section.id }} .sts-visit {
    background: #1c1c1a;
    color: #ffffff;
    padding: 5.6rem 2rem;
  }
  #shopify-section-{{ section.id }} .sts-visit__inner {
    width: min(110rem, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
  }
  #shopify-section-{{ section.id }} .sts-visit__item h2 {
    margin: 0 0 0.8rem;
    font-size: 1.25rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #d4c391;
  }
  #shopify-section-{{ section.id }} .sts-visit__item p,
  #shopify-section-{{ section.id }} .sts-visit__item a {
    margin: 0;
    color: #ffffff;
    font-size: 1.5rem;
    line-height: 1.6;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .sts-visit__item a:hover {
    color: #d4c391;
  }
  #shopify-section-{{ section.id }} .sts-visit__social {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .sts-visit__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.8rem;
    height: 2.8rem;
    color: #ffffff;
  }
  #shopify-section-{{ section.id }} .sts-visit__social svg,
  #shopify-section-{{ section.id }} .sts-visit__social .svg-wrapper {
    width: 2.2rem;
    height: 2.2rem;
    fill: currentColor;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sts-visit__inner {
      grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
      gap: 3rem;
    }
  }
{%- endstyle -%}

<article class="sts-pretty-page sts-pretty-page--about">
  <section class="sts-banner">
    <div class="sts-banner__media">
      <img src="{{ 'sts-highlight-15.jpg' | asset_url }}" alt="About" width="2000" height="900" class="sts-banner__img">
    </div>
    <div class="sts-banner__overlay" aria-hidden="true"></div>
    <div class="sts-banner__content">
      <h2 class="sts-banner__heading">About</h2>
      <div class="sts-banner__text rte"><p>The City of London's finest wine shop, with an all-weather tasting terrace on historic St Swithin's Lane.</p></div>
      <a href="/visit" class="sts-btn sts-btn--outline">PLAN A VISIT</a>
    </div>
  </section>
  <section class="sts-prose">
    <div class="sts-prose__inner">
      <p class="sts-prose__eyebrow">About us</p>
      <h1 class="sts-prose__heading">A destination for wine enthusiasts</h1>
      <div class="sts-prose__text rte"><p>Welcome to St Swithins Wine Shippers, the City of London's finest wine shop with an all-weather tasting terrace on historic St Swithin's Lane. A destination for wine enthusiasts and connoisseurs alike, with Enomatics and Coravin.</p></div>
      <div class="sts-prose__actions">
        <a href="/visit" class="sts-btn sts-btn--solid">PLAN A VISIT</a>
      </div>
    </div>
  </section>
  <section class="sts-features">
    <div class="sts-features__inner">
      <div class="sts-features__grid">
        <article class="sts-features__card">
          <h2>Enomatics</h2>
          <p>48 wines on taste every weekday from our state-of-the-art Enomatic machines, where you can try a little, or a lot, of a truly diverse array of wines from around the world.</p>
        </article>
        <article class="sts-features__card">
          <h2>Coravin</h2>
          <p>Rare, and very rare, Grand Cru wines by the glass from our Coravin extractor. Your chance to taste some of the great names and historic vintages.</p>
        </article>
        <article class="sts-features__card">
          <h2>Tasting terrace</h2>
          <p>Platters and nibbles to match your wine, served all day out on our tasting terrace.</p>
        </article>
        <article class="sts-features__card">
          <h2>Wine gifts</h2>
          <p>Hundreds of bottles for everyday or special occasions, plus gifts for connoisseurs: Riedel glassware and decanters, wine books, corkscrews, cigars, and Coravin machines.</p>
        </article>
      </div>
    </div>
  </section>
  <section class="sts-split sts-split--image-right">
    <div class="sts-split__inner">
      <div class="sts-split__media">
        <img src="{{ 'sts-highlight-35.jpg' | asset_url }}" alt="Food" width="900" height="1100" loading="lazy">
      </div>
      <div class="sts-split__copy">
        <h2>Food</h2>
        <p>We serve a tempting range of platters and pots on our tasting terrace throughout the day. Each platter is accompanied by our fresh bread selection. Take a table on the all-weather terrace and enjoy a charcuterie board or artisan cheeses to complement wines by the glass or by the bottle.</p>
      </div>
    </div>
  </section>
  {% render 'sts-pretty-gallery', heading: 'The cellar & terrace', text: '<p>Wine by the glass, bottles to take home, and a terrace for lingering. Photographed at St Swithins in the City.</p>', background: '#ffffff' %}
</article>

<article class="sts-pretty-page sts-pretty-page--visit">
  <section class="sts-banner">
    <div class="sts-banner__media">
      <img src="{{ 'sts-highlight-06.jpg' | asset_url }}" alt="Visit" width="2000" height="900" class="sts-banner__img">
    </div>
    <div class="sts-banner__overlay" aria-hidden="true"></div>
    <div class="sts-banner__content">
      <h2 class="sts-banner__heading">Visit</h2>
      <div class="sts-banner__text rte"><p>The City's finest wine shop with an all-weather tasting terrace.</p></div>
      <a href="/visit#sts-booking" class="sts-btn sts-btn--outline">BOOK A TABLE</a>
    </div>
  </section>
  <section class="sts-prose">
    <div class="sts-prose__inner">
      <p class="sts-prose__eyebrow">St Swithin's Lane</p>
      <h1 class="sts-prose__heading">Come in for a glass, a bottle, or an afternoon on the terrace</h1>
      <div class="sts-prose__text rte"><p>We are on historic St Swithin's Lane, close to Bank and Cannon Street stations. The shop is open Monday to Friday, 12pm–10pm.</p></div>
    </div>
  </section>
  <section class="sts-resdiary" id="sts-booking">
    <div class="sts-resdiary__inner">
      <p class="sts-resdiary__eyebrow">Reservations</p>
      <h2 class="sts-resdiary__heading">Book a table</h2>
      <div class="sts-resdiary__text rte"><p>Reserve a table on the tasting terrace. Monday to Friday, 12pm–10pm. For larger groups, email info@stswithinswineshippers.com or call 020 7621 9972.</p></div>
      <iframe class="sts-resdiary__frame" src="{{ widget_url }}" title="Book a table" loading="lazy"></iframe>
      <p class="sts-resdiary__fallback">
        <a href="{{ widget_url }}" class="sts-btn sts-btn--solid" target="_blank" rel="noopener">Open booking</a>
      </p>
    </div>
  </section>
  <section class="sts-visit">
    <div class="sts-visit__inner">
      <div class="sts-visit__item">
        <h2>Hours</h2>
        <p>Monday to Friday, 12pm–10pm</p>
      </div>
      <div class="sts-visit__item">
        <h2>Find us</h2>
        <p>11-12 St Swithin's Lane, London EC4N 8AL. Close to Bank and Cannon Street stations.</p>
      </div>
      <div class="sts-visit__item">
        <h2>Enquire</h2>
        <p><a href="tel:+442076219972">+44 20 7621 9972</a></p>
        <p><a href="mailto:info@stswithinswineshippers.com">info@stswithinswineshippers.com</a></p>
      </div>
      <div class="sts-visit__item">
        <h2>General manager</h2>
        <p>Frederic Ahuir</p>
      </div>
    </div>
  </section>
  <section class="sts-split">
    <div class="sts-split__inner">
      <div class="sts-split__media">
        <img src="{{ 'sts-highlight-02.jpg' | asset_url }}" alt="Wine gifts" width="900" height="1100" loading="lazy">
      </div>
      <div class="sts-split__copy">
        <h2>Wine gifts</h2>
        <p>A bottle of wine to take home for dinner? A special bottle for a special occasion? All our wines can be gift-wrapped. Or perhaps a presentation box of vintage Champagne with its own glasses, a beautiful decanter, an antique corkscrew, a wine compendium, or a Coravin machine.</p>
      </div>
    </div>
  </section>
  <section class="sts-split sts-split--image-right">
    <div class="sts-split__inner">
      <div class="sts-split__media">
        <img src="{{ 'sts-highlight-28.jpg' | asset_url }}" alt="Coravin" width="900" height="1100" loading="lazy">
      </div>
      <div class="sts-split__copy">
        <h2>Coravin</h2>
        <p>Aspiration in a glass. With our Coravin extraction you can sample rare wines that previously were beyond reach. A surgical-quality needle pierces the cork, extracts your measure, and leaves the cork to re-form. Taste a great vintage — a Domaine de la Romanée-Conti or a Château Lafite — by the glass.</p>
      </div>
    </div>
  </section>
  {% render 'sts-pretty-gallery', heading: 'The cellar & terrace', text: '<p>Wine by the glass, bottles to take home, and a terrace for lingering.</p>', background: '#ffffff' %}
</article>

<article class="sts-pretty-page sts-pretty-page--contact">
  <section class="sts-banner">
    <div class="sts-banner__media">
      <img src="{{ 'sts-highlight-13.jpg' | asset_url }}" alt="Contact" width="2000" height="900" class="sts-banner__img">
    </div>
    <div class="sts-banner__overlay" aria-hidden="true"></div>
    <div class="sts-banner__content">
      <h2 class="sts-banner__heading">Contact</h2>
      <div class="sts-banner__text rte"><p>We are situated on St Swithin's Lane, close to Bank and Cannon Street. Open Monday to Friday, 12pm–10pm.</p></div>
      <a href="/visit" class="sts-btn sts-btn--outline">VISIT US</a>
    </div>
  </section>
  <section class="sts-prose">
    <div class="sts-prose__inner">
      <p class="sts-prose__eyebrow">Get in touch</p>
      <h1 class="sts-prose__heading">Enquire for groups and reservations</h1>
      <div class="sts-prose__text rte"><p>Please email info@stswithinswineshippers.com or call 020 7621 9972. General manager: Frederic Ahuir.</p></div>
    </div>
  </section>
  <section class="sts-visit">
    <div class="sts-visit__inner">
      <div class="sts-visit__item">
        <h2>Hours</h2>
        <p>Monday to Friday, 12pm–10pm</p>
      </div>
      <div class="sts-visit__item">
        <h2>Find us</h2>
        <p>11-12 St Swithin's Lane, London EC4N 8AL</p>
      </div>
      <div class="sts-visit__item">
        <h2>Enquire</h2>
        <p><a href="tel:+442076219972">+44 20 7621 9972</a></p>
        <p><a href="mailto:info@stswithinswineshippers.com">info@stswithinswineshippers.com</a></p>
      </div>
      <div class="sts-visit__item">
        <h2>General manager</h2>
        <p>Frederic Ahuir</p>
      </div>
      <div class="sts-visit__item">
        <h2>Follow us</h2>
        <ul class="sts-visit__social">
          <li>
            <a href="{{ instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
              {{- 'icon-instagram.svg' | inline_asset_content -}}
            </a>
          </li>
          <li>
            <a href="{{ facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
              {{- 'icon-facebook.svg' | inline_asset_content -}}
            </a>
          </li>
          <li>
            <a href="{{ twitter_url }}" target="_blank" rel="noopener" aria-label="X">
              {{- 'icon-twitter.svg' | inline_asset_content -}}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </section>
  <div class="color-scheme-1 gradient">
    <div class="contact page-width page-width--narrow section-{{ section.id }}-padding" style="padding: 4.8rem 2rem 3.6rem;">
      <h2 class="title title-wrapper--no-top-margin h2">Send a message</h2>
      {%- form 'contact', id: 'ContactFormPretty', class: 'isolate' -%}
        {%- if form.posted_successfully? -%}
          <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
            {{- 'icon-success.svg' | inline_asset_content -}}
            {{ 'templates.contact.form.post_success' | t }}
          </h2>
        {%- endif -%}
        <div class="contact__fields">
          <div class="field">
            <input class="field__input" autocomplete="name" type="text" id="ContactFormPretty-name" name="contact[name]" placeholder="{{ 'templates.contact.form.name' | t }}">
            <label class="field__label" for="ContactFormPretty-name">{{ 'templates.contact.form.name' | t }}</label>
          </div>
          <div class="field">
            <input autocomplete="email" type="email" id="ContactFormPretty-email" class="field__input" name="contact[email]" spellcheck="false" autocapitalize="off" aria-required="true" required placeholder="{{ 'templates.contact.form.email' | t }}">
            <label class="field__label" for="ContactFormPretty-email">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
          </div>
        </div>
        <div class="field">
          <input type="tel" id="ContactFormPretty-phone" class="field__input" autocomplete="tel" name="contact[phone]" placeholder="{{ 'templates.contact.form.phone' | t }}">
          <label class="field__label" for="ContactFormPretty-phone">{{ 'templates.contact.form.phone' | t }}</label>
        </div>
        <div class="field">
          <textarea rows="10" id="ContactFormPretty-body" class="text-area field__input" name="contact[body]" placeholder="{{ 'templates.contact.form.comment' | t }}"></textarea>
          <label class="form__label field__label" for="ContactFormPretty-body">{{ 'templates.contact.form.comment' | t }}</label>
        </div>
        <div class="contact__button">
          <button type="submit" class="button">{{ 'templates.contact.form.send' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
  {% render 'sts-pretty-gallery', heading: 'Inside the shop', text: '<p>The cellar, the terrace, and the team.</p>', background: '#f5f1ea' %}
</article>

{% schema %}
{
  "name": "STS Pretty pages",
  "tag": "section",
  "class": "section-sts-pretty-pages",
  "settings": []
}
{% endschema %}
