{%- style -%}
  #shopify-section-{{ section.id }} .sts-resdiary {
    background: {{ section.settings.background | default: '#f5f1ea' }};
    padding: {{ section.settings.padding_top | default: 56 }}px 2rem {{ section.settings.padding_bottom | default: 64 }}px;
  }

  #shopify-section-{{ section.id }} .sts-resdiary__inner {
    width: min(72rem, 100%);
    margin: 0 auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sts-resdiary__eyebrow {
    margin: 0 0 1.2rem;
    color: #c4a574;
    font-size: 1.2rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sts-resdiary__heading {
    margin: 0 0 1.2rem;
    font-family: var(--sts-font-display, 'DM Sans', system-ui, sans-serif);
    font-size: clamp(2.8rem, 4.2vw, 4.4rem);
    font-weight: 400;
    color: #1c1c1a;
  }

  #shopify-section-{{ section.id }} .sts-resdiary__text,
  #shopify-section-{{ section.id }} .sts-resdiary__text p {
    margin: 0 0 2.4rem;
    color: #6b6560;
    font-size: 1.55rem;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .sts-resdiary__widget {
    max-width: 60rem;
    margin: 0 auto;
    min-height: 32rem;
  }
{%- endstyle -%}

<section class="sts-resdiary" id="sts-booking" {{ section.shopify_attributes }}>
  <div class="sts-resdiary__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="sts-resdiary__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="sts-resdiary__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="sts-resdiary__text rte">{{ section.settings.text }}</div>
    {%- endif -%}

    <div class="sts-resdiary__widget">
      <div id="rd-widget-frame" style="max-width: 600px; margin: auto;"></div>
      <input
        id="rdwidgeturl"
        name="rdwidgeturl"
        value="{{ section.settings.widget_url | default: 'https://booking.resdiary.com/widget/Standard/StSwithinsWineShippers/53853' }}"
        type="hidden"
      >
    </div>
  </div>
</section>

<script src="https://booking.resdiary.com/bundles/WidgetV2Loader.js"></script>

{% schema %}
{
  "name": "STS Table booking",
  "tag": "section",
  "class": "section-sts-resdiary",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Reservations"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Book a table"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Reserve a table on the tasting terrace. For larger groups, email or call us.</p>"
    },
    {
      "type": "text",
      "id": "widget_url",
      "label": "ResDiary widget URL",
      "default": "https://booking.resdiary.com/widget/Standard/StSwithinsWineShippers/53853"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f5f1ea"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "presets": [{ "name": "STS Table booking" }]
}
{% endschema %}
