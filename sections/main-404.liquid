{%- liquid
  assign pretty_last = ''
  assign pretty_parts = request.path | split: '?' | first | downcase | split: '/'
  for pretty_part in pretty_parts
    if pretty_part != blank
      assign pretty_last = pretty_part
    endif
  endfor
  assign pretty_page = false
  if pretty_last == 'visit' or pretty_last == 'contact' or pretty_last == 'about'
    assign pretty_page = true
  endif
-%}
{%- unless pretty_page -%}
<style type="text/css">
  .template-404 .title + * {
    margin-top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .template-404 .title + * {
      margin-top: 2rem;
    }
  }
</style>

<div class="template-404 page-width page-margin center">
  <p>
    {{ 'templates.404.subtext' | t }}
  </p>
  <h1 class="title">
    {{ 'templates.404.title' | t }}
  </h1>
  {%- if settings.hide_shopping -%}
    <a href="{{ routes.root_url }}" class="button">Home</a>
  {%- else -%}
    <a href="{{ routes.all_products_collection_url }}" class="button">
      {{ 'general.continue_shopping' | t }}
    </a>
  {%- endif -%}
</div>
{%- endunless -%}
