{%- comment -%}
  Always outputs Home, About, Visit, and Contact.
{%- endcomment -%}

{%- liquid
  assign extras = 'Home|home,About|about,Visit|visit,Contact|contact' | split: ','
-%}

{%- for extra in extras -%}
  {%- assign parts = extra | split: '|' -%}
  {%- assign extra_title = parts.first | strip -%}
  {%- assign extra_handle = parts.last | strip -%}
  {%- assign is_current = false -%}
  {%- assign current_path = request.path | default: '' | downcase -%}
  {%- if extra_handle == 'home' -%}
    {%- assign extra_href = '/' -%}
    {%- if template.name == 'index' or current_path == '/' or current_path == '' -%}
      {%- assign is_current = true -%}
    {%- endif -%}
  {%- else -%}
    {%- assign extra_href = '/pages/' | append: extra_handle -%}
    {%- assign extra_href_slash = extra_href | append: '/' -%}
    {%- if page.handle == extra_handle
      or template.suffix == extra_handle
      or current_path == extra_href
      or current_path == extra_href_slash
      or current_path contains extra_href
    -%}
      {%- assign is_current = true -%}
    {%- endif -%}
  {%- endif -%}

  {%- if variant == 'drawer' -%}
    <li>
      <a
        id="HeaderDrawer-{{ extra_handle }}"
        href="{{ extra_href }}"
        class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if is_current %} menu-drawer__menu-item--active is-active{% endif %}"
        {% if is_current %}
          aria-current="page"
        {% endif %}
      >
        {{ extra_title | escape }}
      </a>
    </li>
  {%- else -%}
    <li>
      <a
        id="HeaderMenu-{{ extra_handle }}"
        href="{{ extra_href }}"
        class="header__menu-item list-menu__item link link--text focus-inset{% if is_current %} is-active{% endif %}"
        {% if is_current %}
          aria-current="page"
        {% endif %}
      >
        <span
          {%- if is_current %}
            class="header__active-menu-item"
          {% endif %}
        >
          {{- extra_title | escape -}}
        </span>
      </a>
    </li>
  {%- endif -%}
{%- endfor -%}
