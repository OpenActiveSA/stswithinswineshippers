{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="sts-shop-intro section-{{ section.id }}-padding">
  <h1 class="sts-shop-intro__title">
    {%- if section.settings.heading != blank -%}
      {{ section.settings.heading }}
    {%- else -%}
      {{ collection.title | escape }}
    {%- endif -%}
  </h1>

  {%- if section.settings.text != blank -%}
    <div class="sts-shop-intro__text rte">{{ section.settings.text }}</div>
  {%- elsif collection.description != blank -%}
    <div class="sts-shop-intro__text rte">{{ collection.description }}</div>
  {%- endif -%}

  {%- if section.settings.show_filter_labels -%}
    <div class="sts-shop-intro__filters" aria-hidden="true">
      <span class="sts-shop-intro__filter">TYPE <span>▾</span></span>
      <span class="sts-shop-intro__filter">BRAND <span>▾</span></span>
      <span class="sts-shop-intro__filter">VINTAGE <span>▾</span></span>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "STS Collection intro",
  "tag": "section",
  "class": "section-sts-shop-intro",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop wines with personality",
      "info": "Leave blank to use the collection title"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>From bold reds to crisp whites, every bottle is chosen for its unique story and quality. Explore our collection and uncover something unexpected.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_filter_labels",
      "label": "Show decorative filter labels",
      "default": true,
      "info": "Real filters appear below once enabled in Search & Discovery"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "STS Collection intro"
    }
  ]
}
{% endschema %}
