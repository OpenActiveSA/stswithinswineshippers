{%- comment -%}
  Renders the St Swithins SVG logo from theme assets.
  Accepts:
  - class: extra CSS classes (optional)
  - variant: 'header' (default, white) or 'footer' (black)
{%- endcomment -%}
{%- liquid
  assign logo_file = 'st-swithins-logo.svg'
  if variant == 'footer'
    assign logo_file = 'st-swithins-logo-footer.svg'
  endif

  assign logo_class = 'sts-logo'
  if class != blank
    assign logo_class = logo_class | append: ' ' | append: class
  endif
-%}
<img
  src="{{ logo_file | asset_url }}"
  alt="{{ shop.name | escape }}"
  class="{{ logo_class }}"
  width="149"
  height="76"
  loading="eager"
  decoding="async"
>
