{%- style -%}
  #shopify-section-{{ section.id }} .sts-features {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .sts-features__inner {
    width: min(118rem, 100%);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .sts-features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.6rem;
  }

  #shopify-section-{{ section.id }} .sts-features__card {
    background: #ffffff;
    padding: 2.8rem 2.4rem;
    border-top: 3px solid #d4c391;
  }

  #shopify-section-{{ section.id }} .sts-features__card h2 {
    margin: 0 0 1.2rem;
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #4a1c1c;
  }

  #shopify-section-{{ section.id }} .sts-features__card p,
  #shopify-section-{{ section.id }} .sts-features__card .rte p {
    margin: 0;
    color: #6b6560;
    font-size: 1.45rem;
    line-height: 1.65;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sts-features__grid {
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
      gap: 2rem;
    }
  }
{%- endstyle -%}

<section class="sts-features" {{ section.shopify_attributes }}>
  <div class="sts-features__inner">
    <div class="sts-features__grid">
      {%- for block in section.blocks -%}
        <article class="sts-features__card" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2>{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "STS Feature cards",
  "tag": "section",
  "class": "section-sts-features",
  "max_blocks": 6,
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 2
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ebe6dc"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "STS Feature cards" }]
}
{% endschema %}
