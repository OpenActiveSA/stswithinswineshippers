{%- capture pretty_guard -%}
  {%- render 'sts-pretty-guard', pretty_route: section.settings.pretty_route -%}
{%- endcapture -%}
{%- if pretty_guard contains 'skip' -%}
  <style>#shopify-section-{{ section.id }}{display:none!important}</style>
{%- else -%}
{%- render 'sts-pretty-mark', pretty_route: section.settings.pretty_route -%}
{%- style -%}
  #shopify-section-{{ section.id }} .sts-features {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .sts-features__inner {
    width: min(118rem, 100%);
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .sts-features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.2rem 5rem;
  }

  #shopify-section-{{ section.id }} .sts-features__card {
    background: transparent;
    padding: 0 0 0.4rem;
    border: 0;
    border-bottom: 1px solid var(--sts-gold);
  }

  #shopify-section-{{ section.id }} .sts-features__card h2 {
    margin: 0 0 1.2rem;
    font-family: var(--sts-font-display, 'DM Sans', system-ui, sans-serif);
    font-size: clamp(2.2rem, 3vw, 3rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--sts-ink);
  }

  #shopify-section-{{ section.id }} .sts-features__card p,
  #shopify-section-{{ section.id }} .sts-features__card .rte p {
    margin: 0 0 1.6rem;
    color: var(--sts-ink);
    font-size: 1.5rem;
    line-height: 1.7;
    max-width: 46rem;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sts-features__grid {
      grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
    }
  }
{%- endstyle -%}

<section class="sts-features" {{ section.shopify_attributes }}>
  <div class="sts-features__inner">
    <div class="sts-features__grid">
      {%- for block in section.blocks -%}
        <article class="sts-features__card" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2>{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="rte">{{ block.settings.text }}</div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "STS Feature cards",
  "tag": "section",
  "class": "section-sts-features",
  "max_blocks": 6,
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 2
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f5f1ea"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    },
    {
      "type": "text",
      "id": "pretty_route",
      "label": "Pretty URL handle",
      "info": "Leave blank except on the 404 template, where this section only renders at /handle."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "STS Feature cards" }]
}
{% endschema %}
