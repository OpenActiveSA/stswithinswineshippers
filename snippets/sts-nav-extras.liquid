{%- comment -%}
  Always outputs Home, About, Visit, and Contact.
  Contact uses /get-in-touch because Shopify reserves GET /contact.
{%- endcomment -%}

{%- liquid
  assign extras = 'Home|home,About|about,Visit|visit,Contact|contact' | split: ','
-%}

{%- for extra in extras -%}
  {%- assign parts = extra | split: '|' -%}
  {%- assign extra_title = parts.first | strip -%}
  {%- assign extra_handle = parts.last | strip -%}
  {%- assign is_current = false -%}
  {%- case extra_handle -%}
    {%- when 'home' -%}
      {%- assign extra_href = '/' -%}
      {%- if template.name == 'index' -%}
        {%- assign is_current = true -%}
      {%- endif -%}
    {%- when 'contact' -%}
      {%- assign extra_href = '/get-in-touch' -%}
      {%- if request.path == '/get-in-touch'
        or request.path == '/pages/contact'
        or page.handle == 'contact'
      -%}
        {%- assign is_current = true -%}
      {%- endif -%}
    {%- else -%}
      {%- assign extra_href = '/' | append: extra_handle -%}
      {%- assign extra_pages = '/pages/' | append: extra_handle -%}
      {%- if request.path == extra_href
        or request.path == extra_pages
        or page.handle == extra_handle
      -%}
        {%- assign is_current = true -%}
      {%- endif -%}
  {%- endcase -%}

  {%- if variant == 'drawer' -%}
    <li>
      <a
        id="HeaderDrawer-{{ extra_handle }}"
        href="{{ extra_href }}"
        class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if is_current %} menu-drawer__menu-item--active{% endif %}"
        {% if is_current %}
          aria-current="page"
        {% endif %}
      >
        {{ extra_title | escape }}
      </a>
    </li>
  {%- else -%}
    <li>
      <a
        id="HeaderMenu-{{ extra_handle }}"
        href="{{ extra_href }}"
        class="header__menu-item list-menu__item link link--text focus-inset"
        {% if is_current %}
          aria-current="page"
        {% endif %}
      >
        <span
          {%- if is_current %}
            class="header__active-menu-item"
          {% endif %}
        >
          {{- extra_title | escape -}}
        </span>
      </a>
    </li>
  {%- endif -%}
{%- endfor -%}
