<section class="sts-hero" {{ section.shopify_attributes }}>
  <div class="sts-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          widths: '800, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          alt: section.settings.heading_line_1
      }}
    {%- else -%}
      <img
        src="{{ 'mainbanner-background.png' | asset_url }}"
        alt="{{ section.settings.heading_line_1 | escape }}"
        width="2400"
        height="1350"
        loading="eager"
        fetchpriority="high"
        class="sts-hero__img"
      >
    {%- endif -%}
    <div class="sts-hero__overlay"></div>
  </div>

  <div class="sts-hero__content">
    <h1 class="sts-hero__heading">
      {%- if section.settings.heading_line_1 != blank -%}
        <span class="sts-hero__line sts-hero__line--light">{{ section.settings.heading_line_1 }}</span>
      {%- endif -%}
      {%- if section.settings.heading_line_2 != blank or section.settings.heading_line_3 != blank -%}
        <span class="sts-hero__line">
          {%- if section.settings.heading_line_2 != blank -%}
            <span class="sts-hero__line--light">{{ section.settings.heading_line_2 }}</span>
          {%- endif -%}
          {%- if section.settings.heading_line_3 != blank -%}
            <span class="sts-hero__line--gold">{% if section.settings.heading_line_2 != blank %} {% endif %}{{ section.settings.heading_line_3 }}</span>
          {%- endif -%}
        </span>
      {%- endif -%}
    </h1>

    <div class="sts-hero__actions">
      {%- if section.settings.button_label_1 != blank -%}
        <a
          href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}"
          class="sts-btn sts-btn--hero-primary"
        >
          {{ section.settings.button_label_1 }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a
          href="{{ section.settings.button_link_2 | default: '#' }}"
          class="sts-btn sts-btn--hero-secondary"
        >
          {{ section.settings.button_label_2 }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "STS Hero",
  "tag": "section",
  "class": "section-sts-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Destination for"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (white)",
      "default": "Wine"
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Heading accent (gold)",
      "default": "Enthusiasts"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "VIEW OUR WINES"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "BOOK A VISIT"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "STS Hero"
    }
  ]
}
{% endschema %}
