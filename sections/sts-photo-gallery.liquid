{%- liquid
  assign gallery_gap = section.settings.gap | default: 4
-%}
{%- capture pretty_guard -%}
  {%- render 'sts-pretty-guard', pretty_route: section.settings.pretty_route -%}
{%- endcapture -%}
{%- if pretty_guard contains 'skip' -%}
  <style>#shopify-section-{{ section.id }}{display:none!important}</style>
{%- else -%}
{%- render 'sts-pretty-mark', pretty_route: section.settings.pretty_route -%}
{%- style -%}
  #shopify-section-{{ section.id }} .sts-gallery {
    background: {{ section.settings.background | default: '#f5f1ea' }};
    padding: {{ section.settings.padding_top | default: 56 }}px 0 {{ section.settings.padding_bottom | default: 56 }}px;
  }

  #shopify-section-{{ section.id }} .sts-gallery__inner {
    width: 100%;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .sts-gallery__intro {
    text-align: center;
    max-width: 62rem;
    margin: 0 auto 2.4rem;
    padding: 0 1.6rem;
  }

  #shopify-section-{{ section.id }} .sts-gallery__heading {
    margin: 0 0 1.2rem;
    font-family: var(--sts-font-display, 'DM Sans', system-ui, sans-serif);
    font-size: clamp(2.8rem, 4.2vw, 4.4rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--sts-ink);
  }

  #shopify-section-{{ section.id }} .sts-gallery__text,
  #shopify-section-{{ section.id }} .sts-gallery__text p {
    margin: 0;
    color: var(--sts-ink);
    font-size: 1.5rem;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .sts-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-flow: dense;
    gap: {{ gallery_gap }}px;
    padding: 0 {{ gallery_gap }}px;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .sts-gallery__item {
    position: relative;
    display: block;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 2 / 3;
    background: #ece8e0;
  }

  #shopify-section-{{ section.id }} .sts-gallery__item--wide {
    grid-column: span 2;
    aspect-ratio: 3 / 2;
  }

  #shopify-section-{{ section.id }} .sts-gallery__item img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sts-gallery__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    #shopify-section-{{ section.id }} .sts-gallery:not(.is-compact) .sts-gallery__item--wide {
      aspect-ratio: auto;
      height: 100%;
      align-self: stretch;
    }
  }

  #shopify-section-{{ section.id }} .sts-gallery.is-compact .sts-gallery__scroller {
    display: flex;
    gap: {{ gallery_gap }}px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 0 {{ gallery_gap }}px 0.4rem;
  }

  #shopify-section-{{ section.id }} .sts-gallery.is-compact .sts-gallery__scroller::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .sts-gallery.is-compact .sts-gallery__item {
    flex: 0 0 72vw;
    width: 72vw;
    max-width: 28rem;
    scroll-snap-align: start;
    grid-column: auto;
  }

  #shopify-section-{{ section.id }} .sts-gallery.is-compact .sts-gallery__item--wide {
    flex-basis: min(88vw, 42rem);
    width: min(88vw, 42rem);
    max-width: 42rem;
    grid-column: auto;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sts-gallery.is-compact .sts-gallery__item {
      flex-basis: 24rem;
      width: 24rem;
      max-width: none;
    }

    #shopify-section-{{ section.id }} .sts-gallery.is-compact .sts-gallery__item--wide {
      flex-basis: 38rem;
      width: 38rem;
    }
  }
{%- endstyle -%}

{%- liquid
  assign uploaded_count = 0
  for block in section.blocks
    if block.type == 'photo' and block.settings.image != blank
      assign uploaded_count = uploaded_count | plus: 1
    endif
  endfor
  assign default_files = 'sts-highlight-06.jpg,sts-highlight-02.jpg,sts-highlight-01.jpg,sts-highlight-45.jpg,sts-highlight-07.jpg,sts-highlight-10.jpg,sts-highlight-35.jpg,sts-highlight-40.jpg,sts-highlight-50.jpg,sts-highlight-30.jpg,sts-highlight-20.jpg,sts-highlight-25.jpg' | split: ','
  assign landscape_names = 'sts-highlight-01.jpg,sts-highlight-15.jpg,sts-highlight-30.jpg,sts-highlight-45.jpg,sts-highlight-50.jpg'
-%}

<section class="sts-gallery{% if section.settings.compact %} is-compact{% endif %}" {{ section.shopify_attributes }}>
  <div class="sts-gallery__inner">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="sts-gallery__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="sts-gallery__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="sts-gallery__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- capture gallery_items -%}
      {%- if uploaded_count > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'photo' and block.settings.image != blank -%}
            {%- assign photo_alt = block.settings.alt | default: section.settings.heading -%}
            {%- assign is_wide = false -%}
            {%- if block.settings.image.aspect_ratio > 1.15 -%}
              {%- assign is_wide = true -%}
            {%- endif -%}
            {%- if is_wide -%}
              {%- assign photo_sizes = '(min-width: 750px) 40vw, 90vw' -%}
            {%- else -%}
              {%- assign photo_sizes = '(min-width: 750px) 24rem, 72vw' -%}
            {%- endif -%}
            <figure class="sts-gallery__item{% if is_wide %} sts-gallery__item--wide{% endif %}" {{ block.shopify_attributes }}>
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 700, 1000, 1400, 1600',
                  sizes: photo_sizes,
                  alt: photo_alt
              }}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for file in default_files -%}
          {%- assign file_name = file | strip -%}
          {%- assign is_wide = false -%}
          {%- if landscape_names contains file_name -%}
            {%- assign is_wide = true -%}
          {%- endif -%}
          <figure class="sts-gallery__item{% if is_wide %} sts-gallery__item--wide{% endif %}">
            <img
              src="{{ file_name | asset_url }}"
              alt="{{ section.settings.heading | default: shop.name | escape }}"
              width="1024"
              height="{% if is_wide %}683{% else %}1536{% endif %}"
              loading="lazy"
            >
          </figure>
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- if section.settings.compact -%}
      <div class="sts-gallery__scroller" data-sts-gallery-scroll>
        {{ gallery_items }}
        {{ gallery_items }}
      </div>
    {%- else -%}
      <div class="sts-gallery__grid">
        {{ gallery_items }}
      </div>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.compact -%}
  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;
      var scroller = root.querySelector('[data-sts-gallery-scroll]');
      if (!scroller) return;

      var paused = false;
      var speed = 0.35;
      var interacting = false;

      function pause() {
        paused = true;
      }
      function resume() {
        if (!interacting) paused = false;
      }

      scroller.addEventListener('pointerenter', pause);
      scroller.addEventListener('pointerleave', function () {
        interacting = false;
        resume();
      });
      scroller.addEventListener('pointerdown', function () {
        interacting = true;
        pause();
      });
      window.addEventListener('pointerup', function () {
        interacting = false;
        resume();
      });
      scroller.addEventListener(
        'touchstart',
        function () {
          interacting = true;
          pause();
        },
        { passive: true }
      );

      function tick() {
        if (!paused) {
          scroller.scrollLeft += speed;
          var half = scroller.scrollWidth / 2;
          if (half > 0 && scroller.scrollLeft >= half) {
            scroller.scrollLeft -= half;
          }
        }
        requestAnimationFrame(tick);
      }

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        requestAnimationFrame(tick);
      }
    })();
  </script>
{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "STS Photo gallery",
  "tag": "section",
  "class": "section-sts-gallery",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The cellar & terrace"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Wine by the glass, bottles to take home, and a terrace for lingering. These photographs are from St Swithins in the City.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f5f1ea"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 16,
      "step": 2,
      "unit": "px",
      "label": "Gap between photos",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "compact",
      "label": "Scrolling photo row",
      "default": false
    },
    {
      "type": "text",
      "id": "pretty_route",
      "label": "Pretty URL handle",
      "info": "Leave blank except on the 404 template, where this section only renders at /handle."
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "STS Photo gallery"
    }
  ]
}
{% endschema %}
