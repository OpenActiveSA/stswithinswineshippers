{%- style -%}
  #shopify-section-{{ section.id }} .sts-split {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .sts-split__inner {
    width: min(118rem, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .sts-split__media img {
    width: 100%;
    height: 100%;
    min-height: 32rem;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .sts-split__copy {
    padding: 1rem 0;
  }

  #shopify-section-{{ section.id }} .sts-split__copy h2 {
    margin: 0 0 1.4rem;
    font-family: var(--sts-font-display, 'DM Sans', system-ui, sans-serif);
    font-size: clamp(2.4rem, 3.5vw, 3.6rem);
    font-weight: 400;
    color: #1c1c1a;
  }

  #shopify-section-{{ section.id }} .sts-split__copy .rte,
  #shopify-section-{{ section.id }} .sts-split__copy p {
    margin: 0;
    color: #6b6560;
    font-size: 1.5rem;
    line-height: 1.7;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sts-split__inner {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }

    #shopify-section-{{ section.id }} .sts-split--image-right .sts-split__media {
      order: 2;
    }
  }
{%- endstyle -%}

<section class="sts-split{% if section.settings.image_position == 'right' %} sts-split--image-right{% endif %}" {{ section.shopify_attributes }}>
  <div class="sts-split__inner">
    <div class="sts-split__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '600, 900, 1200, 1400',
            sizes: '(min-width: 750px) 50vw, 100vw',
            alt: section.settings.heading
        }}
      {%- else -%}
        <img
          src="{{ section.settings.fallback_image | default: 'sts-highlight-15.jpg' | asset_url }}"
          alt="{{ section.settings.heading | escape }}"
          width="900"
          height="1100"
          loading="lazy"
        >
      {%- endif -%}
    </div>
    <div class="sts-split__copy">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "STS Image with text",
  "tag": "section",
  "class": "section-sts-split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "fallback_image",
      "label": "Theme fallback image filename",
      "default": "sts-highlight-15.jpg"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f5f1ea"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "presets": [{ "name": "STS Image with text" }]
}
{% endschema %}
