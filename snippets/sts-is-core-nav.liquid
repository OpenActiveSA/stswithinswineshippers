{%- comment -%}
  Prints 1 when a Shopify menu link is Home, About, Visit, or Contact.
  Those items are rendered separately so a mis-linked admin menu cannot send Visit to Contact.
{%- endcomment -%}
{%- liquid
  assign t = title | default: '' | downcase | strip
  assign h = handle | default: '' | downcase
  assign u = url | default: '' | downcase
  if t == 'home' or t == 'about' or t == 'about us' or t == 'our story' or t == 'visit' or t == 'contact' or t == 'contact us'
    echo '1'
  elsif h == 'home' or h == 'about' or h == 'visit' or h == 'contact'
    echo '1'
  elsif u == '/' or u contains '/pages/about' or u contains '/pages/visit' or u contains '/pages/contact' or u == '/about' or u == '/visit' or u == '/get-in-touch' or u == '/contact' or u == '/contacts' or u == '/contact-us'
    echo '1'
  endif
-%}
