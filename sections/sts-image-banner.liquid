<section class="sts-banner" {{ section.shopify_attributes }}>
  <div class="sts-banner__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          loading: 'lazy',
          widths: '800, 1200, 1600, 2000',
          sizes: '100vw',
          alt: section.settings.heading
      }}
    {%- else -%}
      <img
        src="{{ 'background-second-home-section.png' | asset_url }}"
        alt="{{ section.settings.heading | escape }}"
        width="2000"
        height="900"
        loading="lazy"
        class="sts-banner__img"
      >
    {%- endif -%}
    <div class="sts-banner__overlay"></div>
  </div>

  <div class="sts-banner__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="sts-banner__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="sts-banner__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="sts-btn sts-btn--outline">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "STS Image banner",
  "tag": "section",
  "class": "section-sts-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fine wine shipping. Handled properly."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Wine shipping requires more than standard freight services. It demands specialist knowledge, careful handling and a deep understanding of international wine logistics. STS Wine Shippers provides end-to-end solutions for wineries, distributors and wine businesses across South Africa and around the world.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "OUR STORY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "STS Image banner"
    }
  ]
}
{% endschema %}
