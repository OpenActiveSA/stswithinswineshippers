{%- capture pretty_guard -%}
  {%- render 'sts-pretty-guard', pretty_route: section.settings.pretty_route -%}
{%- endcapture -%}
{%- if pretty_guard contains 'skip' -%}
  <style>#shopify-section-{{ section.id }}{display:none!important}</style>
{%- else -%}
{%- render 'sts-pretty-mark', pretty_route: section.settings.pretty_route -%}
{%- style -%}
  #shopify-section-{{ section.id }} .sts-resdiary {
    background: {{ section.settings.background | default: '#f5f1ea' }};
    padding: {{ section.settings.padding_top | default: 56 }}px 2rem {{ section.settings.padding_bottom | default: 56 }}px;
  }

  #shopify-section-{{ section.id }} .sts-resdiary__inner {
    width: min(72rem, 100%);
    margin: 0 auto;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sts-resdiary__eyebrow {
    margin: 0 0 1.2rem;
    color: var(--sts-gold);
    font-size: 1.2rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sts-resdiary__heading {
    margin: 0 0 1.2rem;
    font-family: var(--sts-font-display, 'DM Sans', system-ui, sans-serif);
    font-size: clamp(2.8rem, 4.2vw, 4.4rem);
    font-weight: 400;
    color: var(--sts-ink);
  }

  #shopify-section-{{ section.id }} .sts-resdiary__text,
  #shopify-section-{{ section.id }} .sts-resdiary__text p {
    margin: 0 0 2.4rem;
    color: var(--sts-ink);
    font-size: 1.55rem;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .sts-resdiary__widget {
    max-width: 60rem;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .sts-resdiary__frame {
    display: block;
    width: 100%;
    max-width: 60rem;
    height: 72rem;
    margin: 0 auto;
    border: 0;
    background: #ffffff;
  }

  #shopify-section-{{ section.id }} .sts-resdiary__fallback {
    margin: 1.6rem 0 0;
  }
{%- endstyle -%}

<section class="sts-resdiary" id="sts-booking" {{ section.shopify_attributes }}>
  <div class="sts-resdiary__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="sts-resdiary__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="sts-resdiary__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="sts-resdiary__text rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- assign widget_url = section.settings.widget_url | default: 'https://booking.resdiary.com/widget/Standard/StSwithinsWineShippers/53853' -%}
    <div class="sts-resdiary__widget" id="rd-widget-frame">
      <iframe
        class="sts-resdiary__frame"
        src="{{ widget_url | escape }}"
        title="{{ section.settings.heading | default: 'Book a table' | escape }}"
        allowtransparency="true"
        loading="lazy"
      ></iframe>
      <p class="sts-resdiary__fallback">
        <a href="{{ widget_url }}" class="sts-btn sts-btn--solid" target="_blank" rel="noopener">
          Open booking
        </a>
      </p>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "STS Table booking",
  "tag": "section",
  "class": "section-sts-resdiary",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Reservations"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Book a table"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Reserve a table on the tasting terrace. For larger groups, email or call us.</p>"
    },
    {
      "type": "text",
      "id": "widget_url",
      "label": "ResDiary widget URL",
      "default": "https://booking.resdiary.com/widget/Standard/StSwithinsWineShippers/53853"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f5f1ea"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    },
    {
      "type": "text",
      "id": "pretty_route",
      "label": "Pretty URL handle",
      "info": "Leave blank except on the 404 template, where this section only renders at /handle."
    }
  ],
  "presets": [{ "name": "STS Table booking" }]
}
{% endschema %}
