{%- style -%}
  #shopify-section-{{ section.id }} .sts-prose {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .sts-prose__inner {
    width: min(76rem, 100%);
    margin: 0 auto;
    text-align: {{ section.settings.alignment }};
  }

  #shopify-section-{{ section.id }} .sts-prose__eyebrow {
    margin: 0 0 1.2rem;
    color: #c4a574;
    font-size: 1.2rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sts-prose__heading {
    margin: 0 0 1.8rem;
    font-family: var(--sts-font-display, 'DM Sans', system-ui, sans-serif);
    font-size: clamp(2.8rem, 4.4vw, 4.6rem);
    font-weight: 400;
    line-height: 1.15;
    color: #1c1c1a;
  }

  #shopify-section-{{ section.id }} .sts-prose__text,
  #shopify-section-{{ section.id }} .sts-prose__text p {
    margin: 0 0 1.4rem;
    color: #6b6560;
    font-size: 1.55rem;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .sts-prose__text p:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .sts-prose__actions {
    margin-top: 2.4rem;
  }
{%- endstyle -%}

<section class="sts-prose" {{ section.shopify_attributes }}>
  <div class="sts-prose__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="sts-prose__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="sts-prose__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="sts-prose__text rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="sts-prose__actions">
        <a href="{{ section.settings.button_link | default: '#' }}" class="sts-btn sts-btn--solid">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "STS Page intro",
  "tag": "section",
  "class": "section-sts-prose",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "St Swithins Wine Shippers"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f5f1ea"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "presets": [{ "name": "STS Page intro" }]
}
{% endschema %}
