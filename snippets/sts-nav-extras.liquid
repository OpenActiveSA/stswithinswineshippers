{%- comment -%}
  Always outputs About, Visit, and Contact with the correct page URLs.
{%- endcomment -%}

{%- liquid
  assign extras = 'About|about,Visit|visit,Contact|contact' | split: ','
-%}

{%- for extra in extras -%}
  {%- assign parts = extra | split: '|' -%}
  {%- assign extra_title = parts.first | strip -%}
  {%- assign extra_handle = parts.last | strip -%}
  {%- assign extra_path = '/pages/' | append: extra_handle -%}
  {%- if pages[extra_handle].url != blank -%}
    {%- assign extra_href = pages[extra_handle].url -%}
  {%- else -%}
    {%- assign extra_href = extra_path -%}
  {%- endif -%}
  {%- assign is_current = false -%}
  {%- if request.path == extra_path or page.handle == extra_handle -%}
    {%- assign is_current = true -%}
  {%- endif -%}

  {%- if variant == 'drawer' -%}
    <li>
      <a
        id="HeaderDrawer-{{ extra_handle }}"
        href="{{ extra_href }}"
        class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if is_current %} menu-drawer__menu-item--active{% endif %}"
        {% if is_current %}
          aria-current="page"
        {% endif %}
      >
        {{ extra_title | escape }}
      </a>
    </li>
  {%- else -%}
    <li>
      <a
        id="HeaderMenu-{{ extra_handle }}"
        href="{{ extra_href }}"
        class="header__menu-item list-menu__item link link--text focus-inset"
        {% if is_current %}
          aria-current="page"
        {% endif %}
      >
        <span
          {%- if is_current %}
            class="header__active-menu-item"
          {% endif %}
        >
          {{- extra_title | escape -}}
        </span>
      </a>
    </li>
  {%- endif -%}
{%- endfor -%}
