{%- style -%}
  #shopify-section-{{ section.id }} .sts-gallery {
    background: {{ section.settings.background | default: '#f5f1ea' }};
    padding: {{ section.settings.padding_top | default: 64 }}px 0 {{ section.settings.padding_bottom | default: 72 }}px;
  }

  #shopify-section-{{ section.id }} .sts-gallery__inner {
    width: min(118rem, calc(100% - 3.2rem));
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .sts-gallery__intro {
    text-align: center;
    max-width: 62rem;
    margin: 0 auto 3.6rem;
  }

  #shopify-section-{{ section.id }} .sts-gallery__heading {
    margin: 0 0 1.2rem;
    font-family: var(--sts-font-display, 'DM Sans', system-ui, sans-serif);
    font-size: clamp(2.8rem, 4.2vw, 4.4rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    color: #1c1c1a;
  }

  #shopify-section-{{ section.id }} .sts-gallery__text,
  #shopify-section-{{ section.id }} .sts-gallery__text p {
    margin: 0;
    color: #6b6560;
    font-size: 1.5rem;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .sts-gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ section.settings.gap | default: 12 }}px;
  }

  #shopify-section-{{ section.id }} .sts-gallery__item {
    position: relative;
    overflow: hidden;
    background: #1c1c1a;
    min-height: 22rem;
  }

  #shopify-section-{{ section.id }} .sts-gallery__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    min-height: 22rem;
    transition: transform 0.6s ease;
  }

  #shopify-section-{{ section.id }} .sts-gallery__item:hover img {
    transform: scale(1.04);
  }

  #shopify-section-{{ section.id }} .sts-gallery.is-compact .sts-gallery__item,
  #shopify-section-{{ section.id }} .sts-gallery.is-compact .sts-gallery__item img {
    min-height: 18rem;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .sts-gallery__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: {{ section.settings.gap | default: 12 }}px;
    }

    #shopify-section-{{ section.id }} .sts-gallery__item {
      min-height: 28rem;
    }

    #shopify-section-{{ section.id }} .sts-gallery__item img {
      min-height: 28rem;
    }

    #shopify-section-{{ section.id }} .sts-gallery:not(.is-compact) .sts-gallery__item:nth-child(1),
    #shopify-section-{{ section.id }} .sts-gallery:not(.is-compact) .sts-gallery__item:nth-child(6) {
      grid-column: span 2;
      min-height: 42rem;
    }

    #shopify-section-{{ section.id }} .sts-gallery:not(.is-compact) .sts-gallery__item:nth-child(1) img,
    #shopify-section-{{ section.id }} .sts-gallery:not(.is-compact) .sts-gallery__item:nth-child(6) img {
      min-height: 42rem;
    }

    #shopify-section-{{ section.id }} .sts-gallery.is-compact .sts-gallery__item,
    #shopify-section-{{ section.id }} .sts-gallery.is-compact .sts-gallery__item img {
      min-height: 24rem;
    }
  }
{%- endstyle -%}

{%- liquid
  assign uploaded_count = 0
  for block in section.blocks
    if block.type == 'photo' and block.settings.image != blank
      assign uploaded_count = uploaded_count | plus: 1
    endif
  endfor
  assign default_files = 'sts-highlight-06.jpg,sts-highlight-02.jpg,sts-highlight-07.jpg,sts-highlight-10.jpg,sts-highlight-01.jpg,sts-highlight-45.jpg,sts-highlight-35.jpg,sts-highlight-40.jpg,sts-highlight-20.jpg,sts-highlight-25.jpg,sts-highlight-50.jpg,sts-highlight-30.jpg,sts-highlight-65.jpg' | split: ','
  assign compact_files = 'sts-highlight-06.jpg,sts-highlight-13.jpg,sts-highlight-35.jpg,sts-highlight-65.jpg' | split: ','
  if section.settings.compact
    assign default_files = compact_files
  endif
-%}

<section class="sts-gallery{% if section.settings.compact %} is-compact{% endif %}" {{ section.shopify_attributes }}>
  <div class="sts-gallery__inner">
    {%- if section.settings.heading != blank or section.settings.text != blank -%}
      <div class="sts-gallery__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="sts-gallery__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="sts-gallery__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sts-gallery__grid">
      {%- if uploaded_count > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'photo' and block.settings.image != blank -%}
            {%- assign photo_alt = block.settings.alt | default: section.settings.heading -%}
            <figure class="sts-gallery__item" {{ block.shopify_attributes }}>
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 700, 1000, 1400, 1600',
                  sizes: '(min-width: 750px) 25vw, 50vw',
                  alt: photo_alt
              }}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for file in default_files -%}
          <figure class="sts-gallery__item">
            <img
              src="{{ file | strip | asset_url }}"
              alt="{{ section.settings.heading | default: shop.name | escape }}"
              width="800"
              height="1000"
              loading="lazy"
            >
          </figure>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "STS Photo gallery",
  "tag": "section",
  "class": "section-sts-gallery",
  "max_blocks": 16,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The cellar & terrace"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Wine by the glass, bottles to take home, and a terrace for lingering. These photographs are from St Swithins in the City.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f5f1ea"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    },
    {
      "type": "range",
      "id": "gap",
      "min": 2,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Gap between photos",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "compact",
      "label": "Compact row (4 photos)",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "STS Photo gallery"
    }
  ]
}
{% endschema %}
