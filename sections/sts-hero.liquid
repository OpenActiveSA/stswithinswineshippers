{%- style -%}
  #shopify-section-{{ section.id }} .sts-hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #1c1c1a;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .sts-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .sts-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease;
  }

  #shopify-section-{{ section.id }} .sts-hero__slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .sts-hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .sts-hero__overlay {
    position: absolute !important;
    inset: 0 !important;
    z-index: 2 !important;
    pointer-events: none !important;
    display: block !important;
    opacity: 1 !important;
    background:
      linear-gradient(
        180deg,
        rgba(28, 28, 26, 0.95) 0%,
        rgba(28, 28, 26, 0.65) 18%,
        rgba(28, 28, 26, 0) 40%
      ),
      rgba(28, 28, 26, 0.5) !important;
  }

  #shopify-section-{{ section.id }} .sts-hero__content {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 96rem;
    margin: 0 auto;
    padding: 14rem 2rem 7rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .sts-hero__heading {
    margin: 0 0 3rem;
    font-family: 'DM Sans', system-ui, sans-serif !important;
    font-weight: 300 !important;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .sts-hero__line {
    display: block;
    font-size: clamp(3.6rem, 7.5vw, 7.2rem);
    font-weight: 300 !important;
  }

  #shopify-section-{{ section.id }} .sts-hero__line--light {
    color: #ffffff !important;
  }

  #shopify-section-{{ section.id }} .sts-hero__line--gold {
    color: #d4c391 !important;
  }

  #shopify-section-{{ section.id }} .sts-btn--hero-primary {
    background: #ffffff;
    color: #4a1c1c;
    border: 1px solid #ffffff;
    border-radius: 999px;
    min-width: 18rem;
    min-height: 5.2rem;
    padding: 0 2.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1.45rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sts-btn--hero-secondary {
    background: rgba(28, 28, 26, 0.45);
    color: #d4c391 !important;
    border: 2px solid #d4c391;
    border-radius: 999px;
    min-width: 18rem;
    min-height: 5.2rem;
    padding: 0 2.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 1.45rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .sts-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .sts-hero__dots {
    position: absolute;
    left: 50%;
    bottom: 2.8rem;
    transform: translateX(-50%);
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  #shopify-section-{{ section.id }} .sts-hero__dot {
    width: 1.1rem;
    height: 1.1rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.55);
    cursor: pointer;
    transition: width 0.25s ease, background 0.25s ease;
  }

  #shopify-section-{{ section.id }} .sts-hero__dot.is-active {
    width: 3.2rem;
    background: #d4c391;
  }
{%- endstyle -%}

{%- liquid
  assign slide_files = 'mainbanner-background.png,mainbanner2-background.png,mainbanner3-background.png,mainbanner4-background.png' | split: ','
  assign slide_count = 0
  if section.blocks.size > 0
    for block in section.blocks
      if block.type == 'slide' and block.settings.image != blank
        assign slide_count = slide_count | plus: 1
      endif
    endfor
  endif
-%}

<section
  class="sts-hero"
  data-sts-hero
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>
  <div class="sts-hero__media">
    {%- if slide_count > 0 -%}
      {%- assign index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' and block.settings.image != blank -%}
          <div
            class="sts-hero__slide{% if index == 0 %} is-active{% endif %}"
            data-sts-slide
            {{ block.shopify_attributes }}
          >
            {{
              block.settings.image
              | image_url: width: 2400
              | image_tag:
                loading: 'eager',
                widths: '800, 1200, 1600, 2000, 2400',
                sizes: '100vw',
                alt: section.settings.heading_line_1
            }}
          </div>
          {%- assign index = index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for file in slide_files -%}
        <div class="sts-hero__slide{% if forloop.first %} is-active{% endif %}" data-sts-slide>
          <img
            src="{{ file | strip | asset_url }}"
            alt="{{ section.settings.heading_line_1 | escape }}"
            width="2400"
            height="1350"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            {% if forloop.first %}fetchpriority="high"{% endif %}
          >
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="sts-hero__overlay" aria-hidden="true"></div>

  <div class="sts-hero__content">
    <h1 class="sts-hero__heading">
      <span class="sts-hero__line sts-hero__line--light">
        {{ section.settings.heading_line_1 | default: 'Destination for' }}
      </span>
      <span class="sts-hero__line">
        <span class="sts-hero__line--light">{{ section.settings.heading_line_2 | default: 'Wine' }}</span><span class="sts-hero__line--gold">&nbsp;{{ section.settings.heading_line_3 | default: 'Enthusiasts' }}</span>
      </span>
    </h1>

    <div class="sts-hero__actions">
      {%- if section.settings.button_label_1 != blank -%}
        <a
          href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}"
          class="sts-btn sts-btn--hero-primary"
        >
          {{ section.settings.button_label_1 }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a
          href="{{ section.settings.button_link_2 | default: '#' }}"
          class="sts-btn sts-btn--hero-secondary"
        >
          {{ section.settings.button_label_2 }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="sts-hero__dots" data-sts-dots aria-label="Banner slides"></div>
</section>

<script>
  (function () {
    const root = document.currentScript.previousElementSibling;
    if (!root || !root.hasAttribute('data-sts-hero')) return;

    const slides = Array.from(root.querySelectorAll('[data-sts-slide]'));
    const dotsWrap = root.querySelector('[data-sts-dots]');
    if (slides.length < 2) {
      if (dotsWrap) dotsWrap.style.display = 'none';
      return;
    }

    let index = 0;
    const autoplay = root.getAttribute('data-autoplay') === 'true';
    const speed = Number(root.getAttribute('data-speed') || 5000);
    let timer;

    slides.forEach((_, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'sts-hero__dot' + (i === 0 ? ' is-active' : '');
      btn.setAttribute('aria-label', 'Go to slide ' + (i + 1));
      btn.addEventListener('click', () => goTo(i, true));
      dotsWrap.appendChild(btn);
    });

    const dots = Array.from(dotsWrap.querySelectorAll('.sts-hero__dot'));

    function goTo(next, user) {
      slides[index].classList.remove('is-active');
      dots[index].classList.remove('is-active');
      index = (next + slides.length) % slides.length;
      slides[index].classList.add('is-active');
      dots[index].classList.add('is-active');
      if (user) restart();
    }

    function next() {
      goTo(index + 1, false);
    }

    function restart() {
      if (!autoplay) return;
      clearInterval(timer);
      timer = setInterval(next, speed);
    }

    restart();
  })();
</script>

{% schema %}
{
  "name": "STS Hero",
  "tag": "section",
  "class": "section-sts-hero",
  "max_blocks": 8,
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Destination for"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (white)",
      "default": "Wine"
    },
    {
      "type": "text",
      "id": "heading_line_3",
      "label": "Heading accent (gold)",
      "default": "Enthusiasts"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button label",
      "default": "VIEW OUR WINES"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "BOOK A VISIT"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. If no slides are added, the 4 theme asset banners are used."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "STS Hero"
    }
  ]
}
{% endschema %}
