<style type="text/css">
  .sts-404-message.title + * {
    margin-top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .sts-404-message.title + * {
      margin-top: 2rem;
    }
  }
</style>

<div class="sts-404-message template-404 page-width page-margin center">
  <p>
    {{ 'templates.404.subtext' | t }}
  </p>
  <h1 class="title">
    {{ 'templates.404.title' | t }}
  </h1>
  {%- if settings.hide_shopping -%}
    <a href="{{ routes.root_url }}" class="button">Home</a>
  {%- else -%}
    <a href="{{ routes.all_products_collection_url }}" class="button">
      {{ 'general.continue_shopping' | t }}
    </a>
  {%- endif -%}
</div>
