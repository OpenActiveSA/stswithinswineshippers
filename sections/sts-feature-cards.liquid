{%- capture pretty_guard -%}
  {%- render 'sts-pretty-guard', pretty_route: section.settings.pretty_route -%}
{%- endcapture -%}
{%- if pretty_guard contains 'skip' -%}
  <style>#shopify-section-{{ section.id }}{display:none!important}</style>
{%- else -%}
{%- render 'sts-pretty-mark', pretty_route: section.settings.pretty_route -%}
{%- style -%}
  #shopify-section-{{ section.id }} .sts-features {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="sts-features" {{ section.shopify_attributes }}>
  <div class="sts-features__inner">
    <div class="sts-features__grid" style="--sts-features-cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <article class="sts-features__card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank or block.settings.fallback_image != blank -%}
            <div class="sts-features__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '320, 480, 640, 900',
                    sizes: '(min-width: 750px) 22vw, 90vw',
                    alt: block.settings.heading
                }}
              {%- else -%}
                <img
                  src="{{ block.settings.fallback_image | asset_url }}"
                  alt="{{ block.settings.heading | escape }}"
                  width="640"
                  height="640"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="sts-features__body">
            {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}
              <span class="sts-features__icon" aria-hidden="true">
                {% render 'sts-feature-icon', icon: block.settings.icon %}
              </span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h2>{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a class="sts-features__link" href="{{ block.settings.link }}">
                <span>{{ block.settings.link_label }}</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "STS Feature cards",
  "tag": "section",
  "class": "section-sts-features",
  "max_blocks": 6,
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 2
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f5f1ea"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    },
    {
      "type": "text",
      "id": "pretty_route",
      "label": "Pretty URL handle",
      "info": "Leave blank except on the 404 template, where this section only renders at /handle."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_image", "label": "Theme fallback image filename" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "grape", "label": "Grapes" },
            { "value": "barrel", "label": "Barrel" },
            { "value": "glasses", "label": "Glasses" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "grape"
        },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "STS Feature cards" }]
}
{% endschema %}
