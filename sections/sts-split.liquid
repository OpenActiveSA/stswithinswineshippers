{%- capture pretty_guard -%}
  {%- render 'sts-pretty-guard', pretty_route: section.settings.pretty_route -%}
{%- endcapture -%}
{%- if pretty_guard contains 'skip' -%}
  <style>#shopify-section-{{ section.id }}{display:none!important}</style>
{%- else -%}
{%- render 'sts-pretty-mark', pretty_route: section.settings.pretty_route -%}
{%- style -%}
  #shopify-section-{{ section.id }} .sts-split {
    background: {{ section.settings.background }};
    padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="sts-split{% if section.settings.image_position == 'right' %} sts-split--image-right{% endif %}" {{ section.shopify_attributes }}>
  <div class="sts-split__inner">
    <div class="sts-split__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'lazy',
            widths: '600, 900, 1200, 1400',
            sizes: '(min-width: 750px) 50vw, 100vw',
            alt: section.settings.heading
        }}
      {%- else -%}
        <img
          src="{{ section.settings.fallback_image | default: 'sts-highlight-15.jpg' | asset_url }}"
          alt="{{ section.settings.heading | escape }}"
          width="1200"
          height="900"
          loading="lazy"
        >
      {%- endif -%}
    </div>
    <div class="sts-split__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sts-split__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="sts-split__link" href="{{ section.settings.button_link }}">
          <span>{{ section.settings.button_label }}</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "STS Image with text",
  "tag": "section",
  "class": "section-sts-split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "fallback_image",
      "label": "Theme fallback image filename",
      "default": "sts-highlight-15.jpg"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f5f1ea"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    },
    {
      "type": "text",
      "id": "pretty_route",
      "label": "Pretty URL handle",
      "info": "Leave blank except on the 404 template, where this section only renders at /handle."
    }
  ],
  "presets": [{ "name": "STS Image with text" }]
}
{% endschema %}
